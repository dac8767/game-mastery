# Copy to .env.local (never commit .env.local).

# Your Convex deployment URL — printed by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The map server behind the Cloudflare tunnel. Players must have passed
# Cloudflare Access once in their browser for images to load.
NEXT_PUBLIC_MAP_SERVER=https://maps.yourdomain.com
