# Caddyfile — battle map file server behind Cloudflare Tunnel.
#
# Caddy listens on plain HTTP inside the Docker network; TLS is terminated
# at Cloudflare's edge and traffic reaches this container only through the
# tunnel, so :80 is safe here.

:80 {
	# Health check endpoint for quick diagnostics
	respond /healthz "ok" 200

	# Web-resolution copies — what the D&D app serves to players.
	handle_path /web/* {
		root * /srv/web
		file_server browse
		header {
			# Encourage Cloudflare edge caching; version filenames on
			# update instead of invalidating.
			Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# Full-resolution originals — for your own use (print, editing).
	handle_path /originals/* {
		root * /srv/originals
		file_server browse
		header {
			Cache-Control "public, max-age=86400"
		}
	}

	# Session recorder: audio in from the browser, in slices.
	#
	# handle_path STRIPS the /recorder prefix, so the app's
	# RECORDER_UPLOAD_URL is https://<host>/recorder and the container
	# sees /chunk/... and /finish/... — which is what server.py routes.
	#
	# Above the catch-all `handle` below it on purpose: Caddy matches
	# handle blocks in the order they are written, and a catch-all first
	# would answer every upload with the landing text and a 200, which
	# the browser would read as a successful upload of nothing.
	handle_path /recorder/* {
		reverse_proxy recorder-api:8080 {
			# A four-hour session is hundreds of small POSTs and one
			# assembly at the end that can take a minute on a spinning
			# disk. The default 30s write timeout ends that mid-file.
			transport http {
				response_header_timeout 5m
			}
		}
	}

	# Root: simple landing that points at the two trees.
	handle {
		respond "Map server up. Browse /web/ or /originals/." 200
	}

	# Basic hardening: no directory access outside the roots, sane logs.
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
