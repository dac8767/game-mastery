# Copy to .env next to docker-compose.yml on the PowerEdge.
# Never commit the real .env — every value below is a credential.

# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel ->
# the install command. It is the long string after `--token`, and only
# that string — not the whole `cloudflared service install ...` line.
TUNNEL_TOKEN=paste-the-long-token-here


# ---- session recorder ------------------------------------------------
#
# Two secrets, one per direction, and they are deliberately different.
#
#   UPLOAD  — signs the tickets the browser carries. The browser never
#             sees this value, only a signature made with it.
#   INGEST  — authenticates the transcript coming back the other way.
#
# One secret for both would mean a bug that leaked the upload side also
# granted writing transcripts. Generate each with:
#
#   openssl rand -hex 32
#
# The SAME two values go on the Convex deployment:
#
#   npx convex env set RECORDER_UPLOAD_SECRET <the first one>
#   npx convex env set RECORDER_INGEST_SECRET <the second one>

RECORDER_UPLOAD_SECRET=run-openssl-rand-hex-32
RECORDER_INGEST_SECRET=run-openssl-rand-hex-32-again

# Where the worker posts the finished transcript. This is the Convex
# HTTP actions host — the .convex.site one, NOT the .convex.cloud one
# the app connects to. `npx convex dashboard` shows both; it is also
# NEXT_PUBLIC_CONVEX_URL with `.cloud` swapped for `.site`.
CONVEX_SITE_URL=https://your-deployment.convex.site

# Which origins the browser may upload from. Exact origins, comma
# separated, no trailing slash and no wildcard: the ticket travels in a
# custom header, so every upload is preflighted and anything not listed
# here is refused before the POST is made.
RECORDER_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Speaker labelling needs a HuggingFace token AND acceptance of the
# pyannote model terms on the site — see RECORDER.md. Leave it empty
# and the transcript still arrives, with every line unattributed.
HF_TOKEN=

# large-v3 is the best and the slowest. On a CPU-only box, distil-large-v3
# is several times faster for a small accuracy cost, and medium is
# faster still. Change it, restart the worker, done.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en

# int8 on a CPU, float16 on a GPU. Left unset the worker picks the one
# that matches WHISPER_DEVICE; set it only to override that.
WHISPER_COMPUTE_TYPE=int8

# How many people are around the table, as a bound on the diarizer. Too
# wide and it splits one loud player into three; too narrow and it
# merges two quiet ones.
RECORDER_MIN_SPEAKERS=2
RECORDER_MAX_SPEAKERS=8

# Days to keep the audio after a transcript has been made. 0 keeps it
# for ever, which is the default because a transcript is not a
# recording and the recording is the only copy of the evening.
RECORDER_KEEP_DAYS=0
